{
  "manifest_version": 3,
  "name": "Site Siege",
  "version": "1.0",
  "description": "Transformă orice pagină web într-un nivel de joc.",
  "permissions": [
    "activeTab",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
    
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}